    </head>
    <body class="o_home_menu_background">
        <div id="wrapwrap" class="  ">
            <a class="o_skip_to_content btn btn-primary rounded-0 visually-hidden-focusable position-absolute start-0" href="#wrap">Skip to Content</a>
                <main>
                    

            <div class="container py-5">
                <div style="max-width: 300px;" class="card border-0 mx-auto bg-100 rounded-0 shadow-sm bg-white o_database_list">
                    <div class="card-body">
                        <div class="text-center pb-3 border-bottom mb-4">
                            <img alt="Logo" style="max-height:120px; max-width: 100%; width:auto" src="/web/binary/company_logo"/>
                        </div>
                        
            <div class="oe_structure" id="oe_structure_login_top"></div>
            <owl-component name="web.user_switch"></owl-component>
            <form role="form" method="post" onsubmit="this.action = &#39;/web/login&#39; + location.hash" data-captcha="login" class="oe_login_form d-none" action="/web/login">
                <input type="hidden" name="csrf_token" value="3f76ebba296249eacfd3f2b76c666cc6111b2954o1779890756"/>


                <div class="mb-3 field-login">
                    <label for="login" class="form-label d-flex justify-content-between">Email</label>
                    <input type="text" placeholder="Email" name="login" id="login" class="form-control" required="required" autocapitalize="off" autocomplete="username"/>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label d-flex justify-content-between">Password
                <a class="btn btn-link btn-sm" tabindex="1" href="/web/reset_password?redirect=%2Freport%2Fpdf%2Fstock.report_picking%2F14%3F">Reset Password</a></label>
                    <input type="password" placeholder="Password" name="password" id="password" class="form-control" required="required" autocomplete="current-password" maxlength="4096"/>
                </div>


                <div class="oe_login_buttons text-center gap-1 d-grid mb-1 pt-3">
                    <button type="submit" class="btn btn-primary">Log in</button>
                    <div class="o_login_auth"></div>
                </div>
                <p class="mt-2 text-center">
                    <a class="btn btn-link btn-sm" href="/web/signup?redirect=%2Freport%2Fpdf%2Fstock.report_picking%2F14%3F">Don't have an account?</a>
                </p>

                <input type="hidden" name="type" value="password"/>
                <input type="hidden" name="redirect" value="/report/pdf/stock.report_picking/14?"/>
            </form>
            <div class="oe_structure" id="oe_structure_login_bottom"></div>
        
                        <div class="text-center small mt-4 pt-3 border-top">
